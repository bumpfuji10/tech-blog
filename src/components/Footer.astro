---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} kyam.net</p>
</footer>
<style>
	footer {
		width: 760px;
		max-width: calc(100% - 2rem);
		margin: 0 auto;
		padding: 2.5rem 1rem 3rem;
		background: transparent;
		border-top: 1px solid var(--border-color);
	}
	p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.75rem;
		letter-spacing: 0;
	}
</style>
