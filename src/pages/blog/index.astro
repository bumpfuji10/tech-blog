---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { sortPostsByPublishedDateDesc } from '../../utils/posts';

const posts = sortPostsByPublishedDateDesc(await getCollection('blog'));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 760px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 4.5rem 1rem;
			}
			.page-kicker {
				margin: 0 0 0.75rem;
				color: var(--accent);
				font-family: var(--font-atkinson), sans-serif;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.page-title {
				font-size: 2.35rem;
				font-weight: 700;
				margin-bottom: 0.75rem;
				color: rgb(var(--black));
				letter-spacing: 0;
			}
			.page-lead {
				max-width: 36rem;
				margin: 0 0 2.75rem;
				color: rgb(var(--gray));
				line-height: 1.9;
			}
			.posts {
				display: flex;
				flex-direction: column;
				gap: 0;
			}
			.post-card {
				display: grid;
				grid-template-columns: 8.5rem 1fr;
				gap: 1.25rem;
				padding: 1.45rem 0;
				background: transparent;
				border-bottom: 1px solid var(--border-color);
			}
			.post-card:hover {
				text-decoration: none;
			}
			.post-title {
				font-size: 1.08rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0 0 0.42rem 0;
				line-height: 1.55;
			}
			.post-card:hover .post-title {
				color: var(--accent-dark);
			}
			.post-description {
				color: rgb(var(--gray));
				font-size: 0.9rem;
				margin: 0;
				line-height: 1.7;
			}
			.post-date {
				color: rgb(var(--gray));
				font-family: var(--font-atkinson), sans-serif;
				font-size: 0.86rem;
				letter-spacing: 0;
			}
			@media (max-width: 720px) {
				.page-title {
					font-size: 1.8rem;
				}
				.post-card {
					grid-template-columns: 1fr;
					gap: 0.35rem;
					padding: 1.25rem 0;
				}
				.post-title {
					font-size: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="page-kicker">archive</p>
			<h1 class="page-title">記事一覧</h1>
			<p class="page-lead">
				技術の学び、設定の記録、あとで参照したい試行錯誤を時系列で置いています。
			</p>
			<div class="posts">
				{
					posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-card">
							<span class="post-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<span>
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-description">{post.data.description}</p>
							</span>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
