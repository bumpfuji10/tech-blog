---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const skills = {
	JobSkills: ['Ruby', 'Ruby on Rails', 'JavaScript', 'Vue.js', 'Sass', 'SQL(MySQL)', 'Docker'],
	ExperiencedSkills: ['PHP', 'Laravel', 'GraphQL', 'TypeScript'],
};

const careers = [
	{
		role: 'Webエンジニア',
		company: '事業会社',
		period: '2025年7月 - 現在',
		description: 'メインとなるプロダクトの開発に従事。',
	},
	{
		role: 'Webエンジニア',
		company: '事業会社',
		period: '2023年2月 - 2025年6月',
		description:
			'オンラインコミュニティプラットフォームの機能開発に従事。社内ツールの改善や、問い合わせ対応なども行う。',
	},
	{
		role: 'サーバーサイドエンジニア',
		company: '事業会社',
		period: '2022年7月 - 2022年12月',
		description: 'レンタルスペースのマッチングプラットフォームの開発に従事。',
	},
	{
		role: 'セールス',
		company: '専門商社',
		period: '2019年4月 - 2022年6月',
		description:
			'防犯カメラをメインとしたセキュリティ関連商材を、分譲マンションの管理組合や賃貸物件オーナーに提案・販売。',
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title="プロフィール - kyam.net"
			description="ソフトウェアエンジニア Yo Kamada のプロフィールページです。"
		/>
	</head>
	<body>
		<Header />
		<main class="about">
			<header class="page-header">
				<p class="eyebrow">profile</p>
				<h1>Yo Kamada</h1>
				<p class="lead">
					都内のSaaSでソフトウェアエンジニアとして働いています。普段は横浜の自宅からリモートで稼働しています。
				</p>
			</header>

			<div class="about-grid">
				<aside class="profile-panel" aria-label="プロフィール概要">
					<img src="/me.png" alt="Yo Kamada" width="120" height="120" />
					<div>
						<h2>Yo Kamada</h2>
						<p>ソフトウェアエンジニア</p>
					</div>
					<dl>
						<div>
							<dt>Location</dt>
							<dd>Yokohama, Japan</dd>
						</div>
						<div>
							<dt>Experience</dt>
							<dd>エンジニア歴 3年</dd>
						</div>
					</dl>
					<div class="social-links">
						<a href="https://github.com/bumpfuji10" target="_blank" rel="noopener noreferrer">GitHub</a>
						<a href="https://x.com/bumpfuji10" target="_blank" rel="noopener noreferrer">X</a>
					</div>
				</aside>

				<div class="content">
					<section aria-labelledby="about-kyam">
						<h2 id="about-kyam">Kyamについて</h2>
						<p>
							このブログは技術的な学びやtips、その他のサムシングなものを書いていくブログです。技術っぽい話が多め、それ以外の話は1割くらいです。
						</p>
					</section>

					<section aria-labelledby="history">
						<h2 id="history">これまで</h2>
						<p>2022年からエンジニアのお仕事をスタートしました。</p>
						<p>
							少しだけPHPやLaravelやGraphQLを触って実装したりテストを書いたりしたあと、2023年2月から都内でオンラインコミュニティのプラットフォームを作る会社にエンジニアとして入社し、開発業務にあたっていました。
						</p>
						<p>
							2025年7月から、都内にあるスタートアップでエンジニアとして横浜の自宅から稼働しています。
						</p>
						<p>夢は海の見える街でワンコと散歩することです。</p>
					</section>

					<section aria-labelledby="skills">
						<h2 id="skills">スキルセット</h2>
						<div class="skill-groups">
							{
								Object.entries(skills).map(([groupName, items]) => (
									<div class="skill-group">
										<h3>{groupName}</h3>
										<ul>
											{items.map((skill) => (
												<li>{skill}</li>
											))}
										</ul>
									</div>
								))
							}
						</div>
					</section>

					<section aria-labelledby="career">
						<h2 id="career">経歴</h2>
						<div class="career-list">
							{
								careers.map((career) => (
									<article class="career-item">
										<p class="period">{career.period}</p>
										<h3>{career.role}</h3>
										<p class="company">{career.company}</p>
										<p>{career.description}</p>
									</article>
								))
							}
						</div>
					</section>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		width: 900px;
		padding-top: 4.5rem;
		padding-bottom: 5rem;
	}
	.page-header {
		margin-bottom: 3rem;
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-family: var(--font-atkinson), sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	h1 {
		margin-bottom: 1rem;
		font-family: var(--font-atkinson), sans-serif;
		font-size: clamp(2.5rem, 7vw, 4.6rem);
		font-weight: 700;
		letter-spacing: 0;
	}
	.lead {
		max-width: 42rem;
		margin: 0;
		color: rgb(var(--gray));
		line-height: 1.9;
	}
	.about-grid {
		display: grid;
		grid-template-columns: 15rem minmax(0, 1fr);
		gap: 3.5rem;
		align-items: start;
	}
	.profile-panel {
		position: sticky;
		top: 5rem;
		display: grid;
		gap: 1.2rem;
		padding-top: 0.25rem;
	}
	.profile-panel img {
		width: 7.5rem;
		height: 7.5rem;
		object-fit: cover;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		box-shadow: var(--box-shadow);
	}
	.profile-panel h2 {
		margin: 0 0 0.25rem;
		font-size: 1.25rem;
		font-weight: 700;
	}
	.profile-panel p,
	.profile-panel dl {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		line-height: 1.7;
	}
	.profile-panel dl {
		display: grid;
		gap: 0.75rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-color);
	}
	.profile-panel dt {
		color: rgb(var(--black));
		font-family: var(--font-atkinson), sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.profile-panel dd {
		margin: 0.1rem 0 0;
	}
	.social-links {
		display: flex;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-color);
	}
	.social-links a {
		border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
	}
	.social-links a:hover {
		border-color: var(--accent);
		color: var(--accent-dark);
		text-decoration: none;
	}
	.content {
		display: grid;
		gap: 3rem;
	}
	.content section {
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--border-color);
	}
	.content section:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}
	.content h2 {
		margin-bottom: 1.1rem;
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: 0;
	}
	.content h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
	}
	.content p {
		margin: 0 0 1rem;
		color: rgb(var(--gray-dark));
		line-height: 1.85;
	}
	.content p:last-child {
		margin-bottom: 0;
	}
	.skill-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.skill-group ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
	}
	.skill-group li {
		padding: 0.25rem 0.6rem;
		color: var(--accent-dark);
		background: color-mix(in srgb, var(--accent-light) 70%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 15%, var(--border-color));
		border-radius: 999px;
		font-size: 0.82rem;
		line-height: 1.5;
	}
	.career-list {
		display: grid;
		gap: 1.5rem;
	}
	.career-item {
		padding-left: 1.2rem;
		border-left: 3px solid var(--accent-light);
	}
	.career-item .period {
		margin-bottom: 0.35rem;
		color: rgb(var(--gray));
		font-family: var(--font-atkinson), sans-serif;
		font-size: 0.84rem;
	}
	.career-item .company {
		margin: 0.2rem 0 0.55rem;
		color: var(--accent-dark);
		font-weight: 700;
	}
	@media (max-width: 760px) {
		.about {
			padding-top: 3.5rem;
		}
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.profile-panel {
			position: static;
			grid-template-columns: auto 1fr;
			column-gap: 1rem;
			align-items: center;
		}
		.profile-panel img {
			grid-row: span 2;
			width: 5.5rem;
			height: 5.5rem;
		}
		.profile-panel dl,
		.social-links {
			grid-column: 1 / -1;
		}
		.skill-groups {
			grid-template-columns: 1fr;
		}
	}
</style>
